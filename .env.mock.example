DATABASE_URL=postgresql+psycopg://bears:local-mock-tests-only@db/bears
DB_PASSWORD=local-mock-tests-only
ENVIRONMENT=local
PIPELINE=mock-v1
AUTO_RECOGNIZE=false
WORKER_TOKEN=replace-with-at-least-24-random-characters
S3_ENDPOINT=http://minio:9000
S3_BUCKET=only-bears
AWS_REGION=us-west-2
CORS_ORIGIN=http://localhost:19000
# These credentials belong only to the disposable local mock-test stack.
MINIO_ROOT_USER=local-bears-mock-tests
MINIO_ROOT_PASSWORD=local-bears-mock-tests-storage-password
