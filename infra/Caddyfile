{
    auto_https off
    admin off
}
:8080 {
    @private path /internal /internal/* /docs /docs/* /redoc /openapi.json /health
    respond @private 404
    @backend path /api/* /auth/*
    handle @backend {
        header Cache-Control "private, no-store"
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
