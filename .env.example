DATABASE_URL=postgresql+psycopg://bears:local-development-only@db/bears
ENVIRONMENT=local
PIPELINE=mock-v1
WORKER_TOKEN=replace-with-at-least-24-random-characters
S3_ENDPOINT=http://minio:9000
S3_BUCKET=only-bears
AWS_REGION=us-west-2
CORS_ORIGIN=http://localhost:5173
# These are local MinIO credentials only; never reuse them for AWS.
MINIO_ROOT_USER=local-bears
MINIO_ROOT_PASSWORD=local-bears-storage-password
